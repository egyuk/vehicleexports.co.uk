---
// One guide per destination port, built from src/data/ports.json (see the
// header of src/data/ports.ts for where the facts came from and what is kept
// out). Sailings are read from the schedule at build time, like the country
// pages, so they follow the weekly refresh with no edit here.
import Layout from '../../../layouts/Layout.astro';
import CountryServices from '../../../components/CountryServices.astro';
import { ports, portHref, sailingsFor, type Port } from '../../../data/ports';
import { continentCountries } from '../../../data/destinations';

export function getStaticPaths() {
  return ports.map(port => ({ params: { port: port.slug }, props: { port } }));
}

const { port } = Astro.props as { port: Port };

const countryLink = Object.values(continentCountries).flat().find(c => c.name === port.country);
const countryHref = countryLink?.href ?? '/car-shipping';
const siblings = ports.filter(p => p.country === port.country && p.slug !== port.slug);

const upcoming = sailingsFor(port);
const rows = upcoming.slice(0, 8);
const days = upcoming
  .map(r => (new Date(r.eta).getTime() - new Date(r.ets).getTime()) / 86400000)
  .filter(n => Number.isFinite(n) && n > 0)
  .sort((a, b) => a - b);
const transit = days.length
  ? (() => {
      const lo = Math.max(1, Math.floor(days[0] / 7));
      return `${lo}-${Math.max(lo + 1, Math.ceil(days[days.length - 1] / 7))} weeks`;
    })()
  : null;
const loadPorts = [...new Set(upcoming.map(r => r.loadPort).filter(Boolean))];
const carriers = [...new Set(upcoming.map(r => (r.carrier || '').trim()).filter(Boolean))];
const listOf = (xs: string[]) =>
  xs.length <= 1 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;

const fmtDate = (d: string) =>
  d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';

const quickFacts = [
  { label: 'Country', value: port.country },
  { label: 'UN/LOCODE', value: port.locode ?? 'Not listed' },
  { label: 'Transit from UK', value: transit ?? 'On enquiry' },
  {
    label: carriers.length > 1 ? 'Shipping Lines' : 'Shipping Line',
    value: carriers[0] ?? 'RoRo & container',
  },
];

const title = `Car Shipping to ${port.name}, ${port.country} | Port Guide`.length <= 60
  ? `Car Shipping to ${port.name}, ${port.country} | Port Guide`
  : `Car Shipping UK to ${port.name}, ${port.country}`;
const description = `Shipping a car from the UK to ${port.fullName}, ${port.country}: where the port is, how vehicles are handled${transit ? `, ${transit} transit` : ''} and upcoming sailings.`.slice(0, 158);

const site = Astro.site?.href?.replace(/\/$/, '') ?? 'https://vehicleexports.co.uk';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'All Destinations', item: site + '/car-shipping' },
    { '@type': 'ListItem', position: 3, name: port.country, item: site + countryHref },
    { '@type': 'ListItem', position: 4, name: port.name, item: site + Astro.url.pathname },
  ],
};
---

<Layout title={title} description={description}>
  <section class="bg-gradient-to-br from-[var(--color-dark)] to-gray-900 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="breadcrumb flex items-center gap-2 text-sm text-gray-400 mb-4 overflow-x-auto whitespace-nowrap">
        <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/car-shipping" class="hover:text-[var(--color-primary)] transition-colors">All Destinations</a>
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href={countryHref} class="hover:text-[var(--color-primary)] transition-colors">{port.country}</a>
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">{port.name}</span>
      </nav>
      <span class="inline-block bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-semibold px-4 py-1.5 rounded-full border border-[var(--color-primary)]/20 mb-4">
        Destination Port Guide
      </span>
      <h1 class="text-3xl lg:text-5xl font-bold text-white font-[family-name:var(--font-heading)] max-w-3xl">Car Shipping to {port.name}, {port.country}</h1>
      <p class="text-gray-400 mt-4 text-lg max-w-3xl">{port.location}</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="relative -mt-8 z-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-6">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          {quickFacts.map(fact => (
            <div class="text-center">
              <div class="text-xs font-medium text-gray-400 uppercase tracking-wider">{fact.label}</div>
              <div class="text-lg font-bold text-gray-900 mt-1 font-[family-name:var(--font-heading)]">{fact.value}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid xl:grid-cols-3 gap-12">
        <div class="xl:col-span-2 min-w-0 space-y-14">
          <div id="about">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">About {port.fullName}</h2>
            <p class="text-gray-600 leading-relaxed mb-4">{port.summary}</p>
            {port.hinterland && <p class="text-gray-600 leading-relaxed"><span class="font-semibold text-gray-900">Area served:</span> {port.hinterland}</p>}
          </div>

          <div id="vehicles">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">How Vehicles Are Handled at {port.name}</h2>
            <p class="text-gray-600 leading-relaxed mb-6">{port.vehicleHandling}</p>
            {port.facts.length > 0 && (
              <dl class="grid sm:grid-cols-2 gap-px bg-gray-100 border border-gray-100 rounded-xl overflow-hidden">
                {port.facts.map(f => (
                  <div class="bg-white p-4">
                    <dt class="text-xs font-medium text-gray-400 uppercase tracking-wider">{f.label}</dt>
                    <dd class="text-sm text-gray-800 mt-1">{f.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>

          <div id="shipping">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-4">Shipping a Car from the UK to {port.name}</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              We handle the whole UK side of an export to {port.name}: sourcing the vehicle, tax-free and
              VAT-qualifying supply where it applies, collection from any UK address, UK customs clearance and
              export documentation, and loading onto the ship by RoRo or container.
              {transit && ` Current carrier schedules show ${transit} port to port${loadPorts.length ? `, sailing from ${listOf(loadPorts)}` : ''}.`}
              {carriers.length > 0 && ` Lines on the route include ${listOf(carriers.slice(0, 4))}.`}
            </p>
            <p class="text-gray-600 leading-relaxed">
              Clearance and registration after arrival are the importer's side of the process. For costs,
              the full sailing schedule and everything else about exporting to {port.country}, see
              our <a href={countryHref} class="text-[var(--color-primary)] font-semibold hover:underline">{port.country} shipping guide</a>.
            </p>
          </div>

          {rows.length > 0 && (
            <div id="sailings">
              <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-[family-name:var(--font-heading)] mb-2">Upcoming Sailings to {port.name}</h2>
              <p class="text-gray-500 text-sm mb-4">Dates are carrier estimates and must be reconfirmed before booking.</p>
              <div class="overflow-x-auto border border-gray-100 rounded-xl">
                <table class="w-full text-sm">
                  <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
                    <tr>
                      <th class="px-4 py-3 font-medium">Departs</th>
                      <th class="px-4 py-3 font-medium">From</th>
                      <th class="px-4 py-3 font-medium">Arrives</th>
                      <th class="px-4 py-3 font-medium">Vessel</th>
                      <th class="px-4 py-3 font-medium">Line</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    {rows.map(r => (
                      <tr>
                        <td class="px-4 py-3 whitespace-nowrap text-gray-900 font-medium">{fmtDate(r.ets)}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-gray-600">{r.loadPort || '—'}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-gray-600">{fmtDate(r.eta)}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-gray-600">{r.vessel || '—'}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-gray-600">{r.carrier || '—'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <a href="/uk-car-sailing-schedule" class="inline-flex items-center gap-1.5 text-sm text-[var(--color-primary)] font-semibold hover:underline mt-3">Full UK sailing schedule</a>
            </div>
          )}

          <CountryServices />
        </div>

        <div class="space-y-6">
          {siblings.length > 0 && (
            <div class="bg-gray-50 rounded-2xl p-6">
              <h3 class="font-semibold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">Other Ports in {port.country}</h3>
              <ul class="space-y-2">
                {siblings.map(p => (
                  <li><a href={portHref(p)} class="flex items-center gap-2 text-sm text-gray-600 hover:text-[var(--color-primary)] transition-colors">
                    <svg class="w-3.5 h-3.5 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    {p.name}
                  </a></li>
                ))}
              </ul>
            </div>
          )}

          <div class="bg-gray-50 rounded-2xl p-6">
            <h3 class="font-semibold text-gray-900 mb-4 font-[family-name:var(--font-heading)]">Related</h3>
            <ul class="space-y-2">
              <li><a href={countryHref} class="flex items-center gap-2 text-sm text-gray-600 hover:text-[var(--color-primary)] transition-colors"><svg class="w-3.5 h-3.5 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>Car shipping to {port.country}</a></li>
              <li><a href="/car-shipping/ports" class="flex items-center gap-2 text-sm text-gray-600 hover:text-[var(--color-primary)] transition-colors"><svg class="w-3.5 h-3.5 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>All destination ports</a></li>
              <li><a href="/uk-car-sailing-schedule" class="flex items-center gap-2 text-sm text-gray-600 hover:text-[var(--color-primary)] transition-colors"><svg class="w-3.5 h-3.5 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>UK sailing schedule</a></li>
            </ul>
          </div>

          <div class="bg-[var(--color-primary)] rounded-2xl p-6 text-center">
            <h3 class="font-semibold text-white text-lg mb-2 font-[family-name:var(--font-heading)]">Shipping to {port.name}?</h3>
            <p class="text-white/80 text-sm mb-4">Get a personalised, itemised quote for your vehicle export.</p>
            <a href="/contact" class="inline-block bg-white text-[var(--color-primary)] px-6 py-2.5 rounded-full font-semibold text-sm hover:shadow-lg transition-all">Get Quote</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
